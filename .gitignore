# Local .terraform directories (provider plugins, modules)
**/.terraform/*

# State files: contain resource IDs, IPs and can contain secrets. Never commit.
*.tfstate
*.tfstate.*

# Saved plan files (may contain sensitive values)
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Variable files: may contain secrets or account-specific values
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# OS / editor files
.DS_Store
.vscode/
.idea/

# NOTE: .terraform.lock.hcl is intentionally committed so provider
# versions are consistent across machines.
